# ===========================================================
# GROQ — openai/gpt-oss-120b
# ===========================================================
# Paste your 3 existing Groq secrets here.

GROQ_GPT_OSS_120B_KEY_1=paste_your_first_groq_secret_here
GROQ_GPT_OSS_120B_KEY_2=paste_your_second_groq_secret_here
GROQ_GPT_OSS_120B_KEY_3=paste_your_third_groq_secret_here

# ===========================================================
# GROQ — llama-3.3-70b-versatile
# ===========================================================
# Same 3 secrets as above, reused. Groq enforces rate limits
# per model, not per key, so each secret gets its own quota
# tracking under each model it is registered for.

GROQ_LLAMA_3_3_70B_KEY_1=paste_your_first_groq_secret_here
GROQ_LLAMA_3_3_70B_KEY_2=paste_your_second_groq_secret_here
GROQ_LLAMA_3_3_70B_KEY_3=paste_your_third_groq_secret_here

# ===========================================================
# GEMINI — gemini-2.5-flash
# ===========================================================
# Paste your 3 existing Gemini secrets here.

GEMINI_2_5_FLASH_KEY_1=paste_your_first_gemini_secret_here
GEMINI_2_5_FLASH_KEY_2=paste_your_second_gemini_secret_here
GEMINI_2_5_FLASH_KEY_3=paste_your_third_gemini_secret_here

# ===========================================================
# GROQ — whisper-large-v3
# ===========================================================
#
# Add as many Whisper keys as you want.
#
# Example:
#
# GROQ_WHISPER_LARGE_V3_KEY_1=...
# GROQ_WHISPER_LARGE_V3_KEY_2=...
# GROQ_WHISPER_LARGE_V3_KEY_3=...
#
# These can be the same Groq secrets used above if desired.
#
# IMPORTANT:
# Multiple keys do NOT necessarily mean multiplied Groq
# organization quota. Groq rate limits are generally applied
# at the organization/project level.

GROQ_WHISPER_LARGE_V3_KEY_1=paste_your_first_groq_secret_here
GROQ_WHISPER_LARGE_V3_KEY_2=paste_your_second_groq_secret_here
GROQ_WHISPER_LARGE_V3_KEY_3=paste_your_third_groq_secret_here


# ===========================================================
# GROQ WHISPER LIMITS
# ===========================================================
#
# Conservative defaults based on Groq's documented
# whisper-large-v3 limits.
#
# Change these if your Groq account/project shows different
# limits.

GROQ_WHISPER_RPM=20
GROQ_WHISPER_RPD=2000
GROQ_WHISPER_ASH=7200
GROQ_WHISPER_ASD=28800

# Maximum upload size in MB.
GROQ_WHISPER_MAX_FILE_MB=100

# Number of workers servicing the Whisper queue.
WHISPER_WORKERS=8

# Queue retry interval.
WHISPER_QUEUE_WAIT_SECONDS=0.5