# Base URL of the Debate Coach API, with no trailing slash.
# Local:      http://localhost:8000
# Production: fill in after the first Cloud Run deploy — gcloud
# run deploy prints the service URL (also visible in the Cloud
# Run console). Placeholder until then.
# Example: https://debate-coach-abc123-uc.a.run.app
NEXT_PUBLIC_API_URL=https://debate-coach-XXXXX.run.app

# Origin of your Cloud Storage bucket. Recordings are uploaded
# from the browser straight to this host, so it has to be in
# the Content-Security-Policy connect-src list (see
# next.config.mjs). Origin only, no path.
NEXT_PUBLIC_STORAGE_ORIGIN=https://storage.googleapis.com

# Canonical site URL, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional camera-based delivery analysis (head direction, hand
# movement), opt-in per recording. Off by default: with this unset
# or false, the app behaves exactly as it does without the feature
# at all — no MediaPipe download, no camera prompt, no new fields
# sent to the API. Must match the backend's VIDEO_ANALYSIS_ENABLED.
NEXT_PUBLIC_VIDEO_ANALYSIS_ENABLED=false

# Identifies this build in the VisualSignalTrack the browser
# uploads (source.client_version). Any short string; Vercel sets
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA automatically in production if
# you'd rather wire that through instead.
NEXT_PUBLIC_CLIENT_VERSION=dev
