# Base URL of the Debate Coach API, with no trailing slash.
# Local:      http://localhost:8000
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origin of your S3-compatible bucket. Recordings are uploaded
# from the browser straight to this host, so it has to be in
# the Content-Security-Policy connect-src list (see
# next.config.mjs). Origin only, no path.
# Example: https://abc123.r2.cloudflarestorage.com
NEXT_PUBLIC_STORAGE_ORIGIN=

# Canonical site URL, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
